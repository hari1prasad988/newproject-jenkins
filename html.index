<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>StyleHub · E‑Commerce</title>
  <!-- Font Awesome 6 (free) -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    /* ---------- RESET & GLOBAL ---------- */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    body {
      background: #f4f7fc;
      display: flex;
      justify-content: center;
      align-items: flex-start;
      min-height: 100vh;
      padding: 1.5rem;
    }

    /* ---------- MAIN APP CARD ---------- */
    .app {
      max-width: 1320px;
      width: 100%;
      background: #ffffff;
      border-radius: 2.5rem;
      box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.15);
      padding: 1.8rem 1.8rem 2rem;
      transition: box-shadow 0.2s;
    }

    /* ---------- HEADER ---------- */
    .header {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 1.2rem 1.8rem;
      margin-bottom: 2rem;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      font-size: 1.9rem;
      font-weight: 800;
      letter-spacing: -0.5px;
      color: #0b1b2f;
    }

    .logo i {
      color: #2f6bff;
      font-size: 2.2rem;
    }

    .logo span {
      background: linear-gradient(135deg, #1e4bd2, #7b2ff7);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    /* search */
    .search-wrapper {
      flex: 1 1 260px;
      display: flex;
      align-items: center;
      background: #f0f4fe;
      border-radius: 60px;
      padding: 0.2rem 0.2rem 0.2rem 1.2rem;
      transition: 0.2s;
      border: 1.5px solid transparent;
    }

    .search-wrapper:focus-within {
      background: #ffffff;
      border-color: #2f6bff;
      box-shadow: 0 0 0 5px rgba(47, 107, 255, 0.12);
    }

    .search-wrapper i {
      color: #6b7a99;
      font-size: 1rem;
      margin-right: 0.75rem;
    }

    .search-wrapper input {
      border: none;
      background: transparent;
      padding: 0.75rem 0;
      width: 100%;
      font-size: 0.95rem;
      outline: none;
      color: #0b1b2f;
    }

    .search-wrapper input::placeholder {
      color: #8b9ab0;
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .icon-btn {
      background: transparent;
      border: none;
      font-size: 1.3rem;
      color: #1f2a44;
      cursor: pointer;
      position: relative;
      width: 46px;
      height: 46px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: 0.15s;
    }

    .icon-btn:hover {
      background: #eef3fe;
      color: #2f6bff;
    }

    .badge {
      position: absolute;
      top: 2px;
      right: 0px;
      background: #ff3b5c;
      color: white;
      font-size: 0.7rem;
      font-weight: 700;
      width: 21px;
      height: 21px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 2.5px solid white;
    }

    .avatar {
      width: 46px;
      height: 46px;
      background: linear-gradient(145deg, #2f6bff, #7b2ff7);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-weight: 700;
      font-size: 1.1rem;
      cursor: pointer;
      border: 2px solid transparent;
      transition: 0.15s;
      margin-left: 0.3rem;
    }

    .avatar:hover {
      border-color: #2f6bff;
      transform: scale(1.03);
    }

    /* ---------- CATEGORY CHIPS ---------- */
    .categories {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem 0.8rem;
      margin-bottom: 2.2rem;
      padding-bottom: 0.6rem;
      border-bottom: 1.5px solid #eef3fc;
    }

    .cat {
      padding: 0.45rem 1.3rem;
      border-radius: 50px;
      background: #f0f4fe;
      font-size: 0.85rem;
      font-weight: 600;
      color: #1f2a44;
      cursor: pointer;
      transition: 0.15s;
      white-space: nowrap;
      border: 1.5px solid transparent;
    }

    .cat:hover {
      background: #e2eaff;
      color: #0b1b2f;
    }

    .cat.active {
      background: #0b1b2f;
      color: white;
      border-color: #0b1b2f;
    }

    /* ---------- HERO BANNER ---------- */
    .hero {
      background: linear-gradient(135deg, #0b1b2f, #1a2d4a);
      border-radius: 2rem;
      padding: 2rem 2.5rem;
      margin-bottom: 2.8rem;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      color: white;
      box-shadow: 0 20px 30px -15px rgba(0, 0, 0, 0.25);
    }

    .hero-text {
      max-width: 520px;
    }

    .hero-tag {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: rgba(255, 255, 255, 0.1);
      backdrop-filter: blur(4px);
      padding: 0.3rem 1.1rem;
      border-radius: 60px;
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      color: #b9d0ff;
      margin-bottom: 0.9rem;
    }

    .hero-tag i {
      color: #ffd966;
    }

    .hero h1 {
      font-size: 2.3rem;
      font-weight: 800;
      letter-spacing: -0.03em;
      line-height: 1.2;
      margin-bottom: 0.5rem;
    }

    .hero h1 i {
      color: #ffd966;
      margin-right: 0.2rem;
    }

    .hero p {
      color: #cbd9f0;
      font-size: 1rem;
      margin-bottom: 1.6rem;
      max-width: 380px;
    }

    .btn-primary {
      background: #2f6bff;
      border: none;
      padding: 0.8rem 2.2rem;
      border-radius: 60px;
      font-weight: 700;
      font-size: 0.95rem;
      color: white;
      display: inline-flex;
      align-items: center;
      gap: 0.65rem;
      cursor: pointer;
      transition: 0.2s;
      box-shadow: 0 12px 22px -8px #2f6bff99;
    }

    .btn-primary:hover {
      background: #1e4bd2;
      transform: translateY(-3px);
      box-shadow: 0 18px 28px -8px #2f6bffcc;
    }

    .hero-visual {
      font-size: 4.8rem;
      background: rgba(255, 255, 255, 0.04);
      padding: 0.6rem 2rem;
      border-radius: 60px;
      border: 1px solid rgba(255, 255, 255, 0.07);
      backdrop-filter: blur(6px);
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }

    .hero-visual i {
      color: #ffd966;
      filter: drop-shadow(0 8px 16px rgba(0, 0, 0, 0.4));
    }

    /* ---------- SECTION TITLE ---------- */
    .section-head {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-bottom: 1.5rem;
    }

    .section-head h2 {
      font-size: 1.7rem;
      font-weight: 800;
      letter-spacing: -0.3px;
      color: #0b1b2f;
    }

    .section-head a {
      text-decoration: none;
      font-weight: 600;
      font-size: 0.9rem;
      color: #2f6bff;
      display: flex;
      align-items: center;
      gap: 0.4rem;
      transition: 0.15s;
    }

    .section-head a:hover {
      color: #1e4bd2;
      gap: 0.7rem;
    }

    /* ---------- PRODUCT GRID ---------- */
    .product-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(195px, 1fr));
      gap: 1.8rem;
      margin-bottom: 2.8rem;
    }

    .product-card {
      background: #ffffff;
      border-radius: 1.8rem;
      padding: 1.3rem 1rem 1.2rem;
      border: 1.5px solid #edf2fa;
      transition: 0.2s ease;
      display: flex;
      flex-direction: column;
      position: relative;
      box-shadow: 0 6px 14px rgba(0, 0, 0, 0.02);
    }

    .product-card:hover {
      transform: translateY(-8px);
      border-color: #d0defc;
      box-shadow: 0 24px 36px -16px rgba(0, 0, 0, 0.12);
    }

    .badge-sale {
      position: absolute;
      top: 0.9rem;
      left: 0.9rem;
      background: #ff3b5c;
      color: white;
      font-size: 0.7rem;
      font-weight: 800;
      padding: 0.25rem 0.85rem;
      border-radius: 40px;
      letter-spacing: 0.3px;
      box-shadow: 0 4px 10px -3px #ff3b5c99;
    }

    .product-img {
      background: #eef4ff;
      border-radius: 1.4rem;
      height: 145px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 3.6rem;
      color: #1f2a44;
      margin-bottom: 1rem;
      transition: 0.15s;
    }

    .product-card:hover .product-img {
      background: #e2ecfe;
    }

    .product-name {
      font-weight: 700;
      font-size: 1rem;
      margin-bottom: 0.15rem;
      color: #0b1b2f;
    }

    .product-desc {
      font-size: 0.78rem;
      color: #6b7a99;
      margin-bottom: 0.7rem;
      flex: 1;
    }

    .price-row {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      margin-bottom: 0.9rem;
    }

    .price-current {
      font-weight: 800;
      font-size: 1.2rem;
      color: #0b1b2f;
      letter-spacing: -0.3px;
    }

    .price-old {
      font-size: 0.8rem;
      color: #8b9ab0;
      text-decoration: line-through;
    }

    .add-btn {
      background: #0b1b2f;
      border: none;
      color: white;
      font-weight: 600;
      padding: 0.7rem 0;
      border-radius: 60px;
      font-size: 0.9rem;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.45rem;
      cursor: pointer;
      transition: 0.15s;
      width: 100%;
    }

    .add-btn:hover {
      background: #2f6bff;
      box-shadow: 0 8px 18px -6px #2f6bff;
    }

    .add-btn i {
      font-size: 0.9rem;
    }

    /* ---------- FEATURES (FOOTER INFO) ---------- */
    .features {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 1.5rem 2rem;
      margin-top: 2rem;
      padding-top: 2rem;
      border-top: 1.5px solid #eef3fc;
    }

    .feature {
      display: flex;
      align-items: center;
      gap: 0.9rem;
      flex: 1 0 150px;
    }

    .feature i {
      font-size: 1.9rem;
      color: #2f6bff;
      width: 2.6rem;
      text-align: center;
    }

    .feature span {
      font-weight: 700;
      font-size: 0.9rem;
      color: #0b1b2f;
      display: block;
    }

    .feature small {
      font-weight: 400;
      font-size: 0.75rem;
      color: #6b7a99;
    }

    /* ---------- FOOTER NOTE ---------- */
    .footer-note {
      margin-top: 2.2rem;
      font-size: 0.75rem;
      color: #8b9ab0;
      text-align: center;
      border-top: 1.5px solid #eef3fc;
      padding-top: 1.5rem;
    }

    .footer-note i {
      color: #ff3b5c;
      margin: 0 0.1rem;
    }

    /* ---------- RESPONSIVE ---------- */
    @media (max-width: 800px) {
      body { padding: 0.8rem; }
      .app { padding: 1.3rem; border-radius: 2rem; }
      .hero { padding: 1.8rem; }
      .hero h1 { font-size: 1.8rem; }
      .hero-visual { font-size: 3.2rem; padding: 0.4rem 1.4rem; }
      .header { flex-direction: column; align-items: stretch; }
      .search-wrapper { flex: 1; }
      .nav-actions { justify-content: flex-end; }
      .categories { flex-wrap: nowrap; overflow-x: auto; padding-bottom: 1rem; }
    }

    @media (max-width: 500px) {
      .product-grid { grid-template-columns: 1fr 1fr; gap: 1rem; }
      .product-img { height: 110px; font-size: 2.8rem; }
      .hero h1 { font-size: 1.5rem; }
      .hero-visual { font-size: 2.6rem; padding: 0.3rem 1rem; }
      .app { padding: 1rem; border-radius: 1.6rem; }
      .price-current { font-size: 1rem; }
      .add-btn { font-size: 0.8rem; padding: 0.6rem 0; }
    }

    @media (max-width: 380px) {
      .product-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <div class="app">

    <!-- ========== HEADER ========== -->
    <header class="header">
      <div class="logo">
        <i class="fas fa-bag-shopping"></i>
        <span>StyleHub</span>
      </div>

      <div class="search-wrapper">
        <i class="fas fa-magnifying-glass"></i>
        <input type="text" placeholder="Search products, brands...">
      </div>

      <div class="nav-actions">
        <button class="icon-btn" aria-label="Wishlist">
          <i class="far fa-heart"></i>
        </button>
        <button class="icon-btn" aria-label="Cart">
          <i class="fas fa-cart-shopping"></i>
          <span class="badge">3</span>
        </button>
        <div class="avatar">JD</div>
      </div>
    </header>

    <!-- ========== CATEGORY PILLS ========== -->
    <div class="categories">
      <span class="cat active">All</span>
      <span class="cat">Clothing</span>
      <span class="cat">Shoes</span>
      <span class="cat">Accessories</span>
      <span class="cat">Electronics</span>
      <span class="cat">Home</span>
      <span class="cat">Beauty</span>
    </div>

    <!-- ========== HERO BANNER ========== -->
    <div class="hero">
      <div class="hero-text">
        <div class="hero-tag"><i class="fas fa-bolt"></i> Flash Sale</div>
        <h1><i class="fas fa-crown"></i> Summer Collection</h1>
        <p>Up to 50% off on trending styles. Limited time only.</p>
        <button class="btn-primary">
          Shop now <i class="fas fa-arrow-right"></i>
        </button>
      </div>
      <div class="hero-visual">
        <i class="fas fa-sun"></i>
        <i class="fas fa-tshirt" style="margin-left: 0.5rem;"></i>
      </div>
    </div>

    <!-- ========== PRODUCTS SECTION ========== -->
    <div class="section-head">
      <h2>🔥 Trending Now</h2>
      <a href="#">View all <i class="fas fa-chevron-right"></i></a>
    </div>

    <div class="product-grid">
      <!-- Card 1 -->
      <div class="product-card">
        <span class="badge-sale">-25%</span>
        <div class="product-img"><i class="fas fa-tshirt"></i></div>
        <div class="product-name">Essential Tee</div>
        <div class="product-desc">Cotton, regular fit</div>
        <div class="price-row">
          <span class="price-current">$29.99</span>
          <span class="price-old">$39.99</span>
        </div>
        <button class="add-btn"><i class="fas fa-plus"></i> Add</button>
      </div>

      <!-- Card 2 -->
      <div class="product-card">
        <div class="product-img"><i class="fas fa-shoe-prints"></i></div>
        <div class="product-name">Air Runner</div>
        <div class="product-desc">Mesh, lightweight</div>
        <div class="price-row">
          <span class="price-current">$89.00</span>
        </div>
        <button class="add-btn"><i class="fas fa-plus"></i> Add</button>
      </div>

      <!-- Card 3 -->
      <div class="product-card">
        <span class="badge-sale">-15%</span>
        <div class="product-img"><i class="fas fa-glasses"></i></div>
        <div class="product-name">Aviator Sunglasses</div>
        <div class="product-desc">UV protection, metal</div>
        <div class="price-row">
          <span class="price-current">$54.50</span>
          <span class="price-old">$64.00</span>
        </div>
        <button class="add-btn"><i class="fas fa-plus"></i> Add</button>
      </div>

      <!-- Card 4 -->
      <div class="product-card">
        <div class="product-img"><i class="fas fa-headphones"></i></div>
        <div class="product-name">Studio Buds</div>
        <div class="product-desc">Wireless, noise cancel</div>
        <div class="price-row">
          <span class="price-current">$129.99</span>
        </div>
        <button class="add-btn"><i class="fas fa-plus"></i> Add</button>
      </div>

      <!-- Card 5 -->
      <div class="product-card">
        <span class="badge-sale">-40%</span>
        <div class="product-img"><i class="fas fa-watch"></i></div>
        <div class="product-name">Chrono Watch</div>
        <div class="product-desc">Stainless steel</div>
        <div class="price-row">
          <span class="price-current">$149.00</span>
          <span class="price-old">$249.00</span>
        </div>
        <button class="add-btn"><i class="fas fa-plus"></i> Add</button>
      </div>

      <!-- Card 6 -->
      <div class="product-card">
        <div class="product-img"><i class="fas fa-couch"></i></div>
        <div class="product-name">Mini Sofa</div>
        <div class="product-desc">Fabric, 2-seater</div>
        <div class="price-row">
          <span class="price-current">$399.00</span>
        </div>
        <button class="add-btn"><i class="fas fa-plus"></i> Add</button>
      </div>
    </div>

    <!-- ========== FEATURES ========== -->
    <div class="features">
      <div class="feature">
        <i class="fas fa-truck"></i>
        <div><span>Free shipping</span><small>on orders over $50</small></div>
      </div>
      <div class="feature">
        <i class="fas fa-rotate-left"></i>
        <div><span>30-day returns</span><small>hassle-free</small></div>
      </div>
      <div class="feature">
        <i class="fas fa-lock"></i>
        <div><span>Secure payment</span><small>256-bit SSL</small></div>
      </div>
      <div class="feature">
        <i class="fas fa-headset"></i>
        <div><span>24/7 support</span><small>live chat & email</small></div>
      </div>
    </div>

    <!-- ========== FOOTER NOTE ========== -->
    <div class="footer-note">
      <i class="far fa-copyright"></i> 2026 StyleHub — made with <i class="fas fa-heart"></i> for you
    </div>
  </div>
</body>
</html>
